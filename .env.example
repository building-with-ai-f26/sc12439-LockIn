# Copy to .env (git-ignored) for the Whoop scripts. The browser game needs none of these.
# The GitHub Action reads the same names from repo Secrets (Settings → Secrets and variables → Actions).

# Supabase project URL, same value as docs/supabase-config.js
SUPABASE_URL=https://qsgehsrgxyrshpavjfip.supabase.co

# Service role key: Supabase → Project Settings → API Keys → service_role (secret).
# Bypasses Row Level Security. Only for scripts/whoop-*.mjs and the Action. NEVER in docs/ or a commit.
SUPABASE_SERVICE_ROLE_KEY=

# Whoop app: https://developer.whoop.com → Create app → copy both.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Must match the Redirect URL registered on the Whoop app. Default is the hosted callback page.
WHOOP_REDIRECT_URI=https://building-with-ai-f26.github.io/sc12439-LockIn/whoop-callback.html

# Optional tuning
WHOOP_MIN_MINUTES=20
WHOOP_WINDOW_DAYS=3
